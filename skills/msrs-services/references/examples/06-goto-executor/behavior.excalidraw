      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Each Cycle: events in arrival order (Pose, Goal, Cancel), then Supervise (T6, T7, T8, T9), then Advance (T10\u2013T12), then one ExecOut.",
      "originalText": "Each Cycle: events in arrival order (Pose, Goal, Cancel), then Supervise (T6, T7, T8, T9), then Advance (T10\u2013T12), then one ExecOut.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "note1",
      "type": "text",
      "x": -19.75,
      "y": 600,
      "width": 1039.5,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#0f172a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
