      "roundness": null,
      "seed": 201391822,
      "version": 1,
      "versionNonce": 1622571747,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Supervise and Advance are separate internal events: statig dispatches child first, so fault rules must not share an event with arrival.",
      "originalText": "Supervise and Advance are separate internal events: statig dispatches child first, so fault rules must not share an event with arrival.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
