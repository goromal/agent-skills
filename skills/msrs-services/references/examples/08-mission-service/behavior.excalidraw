      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Supervise applies contingencies C1\u2013C7 per leaf (SPEC table): first applicable row wins; S6 accepts only landing rows, S7 only C2.",
      "originalText": "Supervise applies contingencies C1\u2013C7 per leaf (SPEC table): first applicable row wins; S6 accepts only landing rows, S7 only C2.",
