      "versionNonce": 1411017409,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "T8 (internal): next leg, at most one per cycle. Each Cycle: planner outputs, events in arrival order, Supervise, Advance, one MissionOut.",
      "originalText": "T8 (internal): next leg, at most one per cycle. Each Cycle: planner outputs, events in arrival order, Supervise, Advance, one MissionOut.",
